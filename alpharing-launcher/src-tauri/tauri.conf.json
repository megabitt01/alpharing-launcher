{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "alpharing-launcher",
  "version": "0.1.0",
  "identifier": "com.jackb.alpharing-launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AlphaRing Launcher",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/launcherIconSmall.png",
      "icons/launcherIcon.png",
      "icons/launcherIcon.png",
      "icons/launcherIcon.icns",
      "icons/launcherIcon.ico"
    ]
  }
}
